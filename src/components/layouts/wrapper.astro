---
import "../../styles/globals.css";

import Metadata from "./metadata.astro";
import Navbar from "./navbar.astro";
import Footer from "./footer.astro";

type Props = {
  title?: string;
  description?: string;
  opengraphImage?: string;
};

const { title, description, opengraphImage } = Astro.props;
---

<!doctype html>
<html lang="pt-br">
  <Metadata
    title={title}
    description={description}
    opengraphImage={opengraphImage}
  />

  <body
    class={"relative mx-auto flex min-h-screen min-h-dvh max-w-[800px] flex-col gap-8 bg-background px-6 lg:px-0"}
  >
    <div
      class="pointer-events-none absolute top-0 left-0 z-[-1] h-full min-h-[32rem] w-full -translate-x-1/3 rotate-45 rounded-full bg-slate-900/28 blur-3xl lg:w-[700px]"
    >
    </div>
    <Navbar />
    <div class="flex-1">
      <slot />
    </div>
    <Footer />
  </body>
</html>
